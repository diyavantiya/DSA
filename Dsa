                                                   // program to INSERT a new node into the LINKED LIST. A node can be added into the linked list using three ways:
                                                   // a. At the front of the list  b. After a given node  c. At the end of the list.



#include <stdio.h>
#include <stdlib.h>

// Structure of a node
struct node
{
    int data;
    struct node *next;
};

struct node *head = NULL;

// Function to create a new node
struct node* createNode(int item)
{
    struct node *newnode;

    newnode = (struct node*)malloc(sizeof(struct node));

    if (newnode == NULL)
    {
        printf("Memory allocation failed\n");
        return NULL;
    }

    newnode->data = item;
    newnode->next = NULL;

    return newnode;
}

// Insert a node at the front
void insertFront(int item)
{
    struct node *newnode;

    newnode = createNode(item);

    if (newnode == NULL)
        return;

    newnode->next = head;
    head = newnode;

    printf("Node inserted at front\n");
}

// Insert a node after a given node value
void insertAfter(int key, int item)
{
    struct node *temp;
    struct node *newnode;

    temp = head;

    // Search for the given node
    while (temp != NULL && temp->data != key)
    {
        temp = temp->next;
    }

    if (temp == NULL)
    {
        printf("Given node not found\n");
        return;
    }

    newnode = createNode(item);

    if (newnode == NULL)
        return;

    newnode->next = temp->next;
    temp->next = newnode;

    printf("Node inserted after %d\n", key);
}

// Insert a node at the end
void insertEnd(int item)
{
    struct node *newnode;
    struct node *temp;

    newnode = createNode(item);

    if (newnode == NULL)
        return;

    // If the list is empty
    if (head == NULL)
    {
        head = newnode;
        printf("Node inserted at end\n");
        return;
    }

    temp = head;

    // Move to the last node
    while (temp->next != NULL)
    {
        temp = temp->next;
    }

    temp->next = newnode;

    printf("Node inserted at end\n");
}

// Display the linked list
void display()
{
    struct node *temp;

    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    temp = head;

    printf("Linked List: ");

    while (temp != NULL)
    {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }

    printf("NULL\n");
}

