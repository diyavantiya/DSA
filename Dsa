                                     // Implement the BINARY TREE and perform any one of the following three types of traversals: ITERATIVE:
                                     // a. Pre-order Traversal   b. In-order Traversal   c. Post-order Traversal



#include <stdio.h>
#include <stdlib.h>

// Structure of a binary tree node
struct node
{
    int data;
    struct node *left;
    struct node *right;
};

// Create a new node
struct node* createNode(int item)
{
    struct node *newnode;

    newnode = (struct node*)malloc(sizeof(struct node));

    if (newnode == NULL)
    {
        printf("Memory allocation failed\n");
        exit(1);
    }

    newnode->data = item;
    newnode->left = NULL;
    newnode->right = NULL;

    return newnode;
}

// Iterative Pre-order: Root, Left, Right
void preorder(struct node *root)
{
    struct node *stack[100];
    int top = -1;
    struct node *temp;

    if (root == NULL)
        return;

    top++;
    stack[top] = root;

    while (top != -1)
    {
        temp = stack[top];
        top--;

        printf("%d ", temp->data);

        // Push right first, so left is processed first
        if (temp->right != NULL)
        {
            top++;
            stack[top] = temp->right;
        }

        if (temp->left != NULL)
        {
            top++;
            stack[top] = temp->left;
        }
    }
}

// Iterative In-order: Left, Root, Right
void inorder(struct node *root)
{
    struct node *stack[100];
    int top = -1;
    struct node *current = root;

    while (current != NULL || top != -1)
    {
        // Push all left nodes
        while (current != NULL)
        {
            top++;
            stack[top] = current;
            current = current->left;
        }

        // Pop and visit the node
        current = stack[top];
        top--;

        printf("%d ", current->data);

        // Move to the right subtree
        current = current->right;
    }
}

// Iterative Post-order: Left, Right, Root
void postorder(struct node *root)
{
    struct node *stack1[100];
    struct node *stack2[100];
    int top1 = -1, top2 = -1;
    struct node *temp;

    if (root == NULL)
        return;

    // Push root into the first stack
    top1++;
    stack1[top1] = root;

    while (top1 != -1)
    {
        // Pop from stack1
        temp = stack1[top1];
        top1--;

        // Push into stack2
        top2++;
        stack2[top2] = temp;

        // Push left child into stack1
        if (temp->left != NULL)
        {
            top1++;
            stack1[top1] = temp->left;
        }

        // Push right child into stack1
        if (temp->right != NULL)
        {
            top1++;
            stack1[top1] = temp->right;
        }
    }

    // Print nodes from stack2
    while (top2 != -1)
    {
        temp = stack2[top2];
        top2--;

        printf("%d ", temp->data);
    }
}

int main()
{
    struct node *root;

    // Create the binary tree
    root = createNode(1);
    root->left = createNode(2);
    root->right = createNode(3);
    root->left->left = createNode(4);
    root->left->right = createNode(5);

    printf("Pre-order Traversal: ");
    preorder(root);

    printf("\nIn-order Traversal: ");
    inorder(root);

    printf("\nPost-order Traversal: ");
    postorder(root);

    printf("\n");

    return 0;
}
