// Insert a node at the end to create the list
void insert(int item)
{
    struct node *newnode, *temp;

    newnode = (struct node*)malloc(sizeof(struct node));

    if (newnode == NULL)
    {
        printf("Memory allocation failed\n");
        return;
    }

    newnode->data = item;
    newnode->next = NULL;

    if (head == NULL)
    {
        head = newnode;
        return;
    }

    temp = head;

    while (temp->next != NULL)
    {
        temp = temp->next;
    }

    temp->next = newnode;
}

// Delete a node from the beginning
void deleteBeginning()
{
    struct node *temp;

    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    temp = head;
    head = head->next;

    printf("Deleted: %d\n", temp->data);
    free(temp);
}

// Delete a node from the end
void deleteEnd()
{
    struct node *temp, *prev;

    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    // If there is only one node
    if (head->next == NULL)
    {
        printf("Deleted: %d\n", head->data);
        free(head);
        head = NULL;
        return;
    }

    temp = head;

    // Move to the last node
    while (temp->next != NULL)
    {
        prev = temp;
        temp = temp->next;
    }

    prev->next = NULL;

    printf("Deleted: %d\n", temp->data);
    free(temp);
}

// Delete a node from the middle using its value
void deleteMiddle(int key)
{
    struct node *temp, *prev;

    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    // If the first node contains the value
    if (head->data == key)
    {
        temp = head;
        head = head->next;

        printf("Deleted: %d\n", temp->data);
        free(temp);
        return;
    }

    temp = head;

    // Search for the node
    while (temp != NULL && temp->data != key)
    {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL)
    {
        printf("Node not found\n");
        return;
    }

    prev->next = temp->next;

    printf("Deleted: %d\n", temp->data);
    free(temp);
}

