                              // Implement various functionalities of Queue using Linked Lists. 


#include <stdio.h>
#include <stdlib.h>

// Structure of a node
struct node
{
    int data;
    struct node *next;
};

struct node *front = NULL;
struct node *rear = NULL;

// Check whether the queue is empty
int isEmpty()
{
    if (front == NULL)
        return 1;
    else
        return 0;
}

// Insert an element into the queue
void enqueue(int item)
{
    struct node *newnode;

    newnode = (struct node *)malloc(sizeof(struct node));

    if (newnode == NULL)
    {
        printf("Memory allocation failed\n");
        return;
    }

    newnode->data = item;
    newnode->next = NULL;

    if (front == NULL)
    {
        front = newnode;
        rear = newnode;
    }
    else
    {
        rear->next = newnode;
        rear = newnode;
    }

    printf("Inserted: %d\n", item);
}

// Delete an element from the queue
void dequeue()
{
    struct node *temp;

    if (isEmpty())
    {
        printf("Queue Underflow\n");
        return;
    }

    temp = front;
    printf("Deleted: %d\n", front->data);

    front = front->next;

    // If the queue becomes empty, reset rear too
    if (front == NULL)
        rear = NULL;

    free(temp);
}

// Print the front element
void printFront()
{
    if (isEmpty())
        printf("Queue is empty\n");
    else
        printf("Front element: %d\n", front->data);
}

// Print the rear element
void printRear()
{
    if (isEmpty())
        printf("Queue is empty\n");
    else
        printf("Rear element: %d\n", rear->data);
}

// Display all elements of the queue
void display()
{
    struct node *temp;

    if (isEmpty())
    {
        printf("Queue is empty\n");
        return;
    }

    temp = front;

    printf("Queue: ");

    while (temp != NULL)
    {
        printf("%d ", temp->data);
