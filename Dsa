    int i, balanced = 1;

    printf("Enter an expression: ");
    fgets(exp, sizeof(exp), stdin);

    // Check each character of the expression
    for (i = 0; exp[i] != '\0'; i++)
    {
        ch = exp[i];

        // Push opening brackets onto the stack
        if (ch == '(' || ch == '{' || ch == '[')
        {
            push(ch);
        }

        // Check closing brackets
        else if (ch == ')' || ch == '}' || ch == ']')
        {
            // No opening bracket is available
            if (top == -1)
            {
                balanced = 0;
                break;
            }

            // Remove the most recent opening bracket
            open = pop();

            // Check whether the bracket pair matches
            if (!isMatching(open, ch))
            {
                balanced = 0;
                break;
            }
        }
    }

    // Unmatched opening brackets remain in the stack
    if (top != -1)
        balanced = 0;

    if (balanced == 1)
        printf("Balanced\n");
    else
        printf("Not Balanced\n");

    return 0;
}



                                       //  Circular queue using Arrays: a. isFull – to check if the queue is full or not.
